FROM python:3.12-slim
# V15 multi-horizon ML deploy trigger; psi_v15*.py is watched by Railway.

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY *.py ./

RUN python -m py_compile psi_runtime_liveness.py psi_strategy_v12_entry.py psi_v12_3_hardening.py psi_v12_3_runner.py psi_outcome_learning.py psi_v12_4_upgrade.py psi_v12_5_upgrade.py psi_v12_6_upgrade.py psi_v12_7_upgrade.py psi_v12_8_upgrade.py psi_v12_9_upgrade.py psi_v13_upgrade.py psi_v13_perf24.py psi_v13_3_execution.py psi_v14_pinpoint.py psi_v14_perf_fix.py psi_v15_multihorizon.py psi_v15_17_ema_lane.py test_v15_17_ema_lane.py psi_v15_21_signal_delivery.py test_v15_21_signal_delivery.py test_v15_24_cache_research.py test_v15_25_unified_buy_feed.py psi_micro_worker.py test_micro_liveness.py psi_sensor_worker.py psi_sensor_worker_v126.py psi_tape_worker.py psi_structure_worker.py psi_extension_worker.py psi_risk_worker.py test_micro_stability.py test_outcome_learning.py test_v12_4_upgrade.py test_v12_5_upgrade.py test_v12_6_upgrade.py test_v12_7_upgrade.py test_v12_8_upgrade.py test_v12_9_upgrade.py test_v13_upgrade.py test_v13_perf24.py test_v13_3_execution.py test_v14_pinpoint.py test_v14_perf_fix.py test_v15_multihorizon.py test_v15_17_ema_lane.py test_runtime_liveness.py && python -m unittest -v test_v12_execution_gate.py test_micro_stability.py test_micro_liveness.py test_outcome_learning.py test_v12_4_upgrade.py test_v12_5_upgrade.py test_v12_6_upgrade.py test_v12_7_upgrade.py test_v12_8_upgrade.py test_v12_9_upgrade.py test_v13_upgrade.py test_v13_perf24.py test_v13_3_execution.py test_v14_pinpoint.py test_v14_perf_fix.py test_v15_multihorizon.py test_v15_21_signal_delivery.py test_v15_24_cache_research.py test_v15_25_unified_buy_feed.py test_runtime_liveness.py

ENV PORT=8080
ENV PSI_SCANNER_VERSION=12.3.4-strict-buy-now-gate
ENV PSI_APPROVED_SCANNER_VERSION=12.3.4-strict-buy-now-gate
ENV PSI_STRATEGY_AUTHORITY=V12_ONLY
ENV PSI_V11_SHADOW_ONLY=1
ENV PSI_BYBIT_ENABLED=0

CMD ["python", "psi_v12_3_runner.py"]
